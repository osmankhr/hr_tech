EXA_API_KEY=your_exa_api_key_here

# OpenRouter (to route Claude Sonnet / LLM calls via OpenRouter)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=anthropic/claude-sonnet-5   (OpenRouter uses a dot for 5.5: anthropic/claude-sonnet-5.5)
# OpenRouter is only a fallback when every Claude CLI profile fails (billed per token).
# CANDIDATE_POOL_OPENROUTER_MAX_USD=5
# CANDIDATE_POOL_OPENROUTER_MODEL_FILTER=anthropic/claude-haiku-5.5   (default; filter step only)

# Optional — only needed if a campaign sets search.provider to one of these:
# DATALABS_API_KEY=your_peopledatalabs_api_key_here
# APOLLO_API_KEY=your_apollo_api_key_here
